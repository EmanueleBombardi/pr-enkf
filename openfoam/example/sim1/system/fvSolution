relaxationFactors 
/* BW: typical of steady solver using SIMPLE to suppress oscillations.
   The recommendation is to always use under-relaxation factors that are as high as
   possible without resulting in oscillations or divergence. Some rules of thumb:
   - Keep the default value if possible
   - Starting from them, decrease the value to improve the stability of the solution
   - You will pay the stability slowing down the solver
   - Trials and errors are frequent to get the best under-relaxation factors
   - Pay attention: adding new equations to solve means introducing new under-relaxation
     factors. If you do not do that the default value will be 1.
*/
{
   /* BW: Not necessary with SIMPLEC*/
   fields
   {
     p               0.5; //default value 0.3
   }
   equations
   {   
     U               0.3; //default value 0.7
     k               0.3; //default value 0.7
     epsilon         0.3; //default value 0.7
     omega	     0.3; //default value 0.7
   }
   
}

