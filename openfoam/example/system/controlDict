FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application       simpleFoam;

startFrom         latestTime;

startTime         0;

stopAt            endTime;

endTime           10000000;

deltaT            1;

writeControl      timeStep;

writeInterval     250;

purgeWrite        1;

writeFormat       ascii;

writePrecision    6;

writeCompression  uncompressed;

timeFormat        general;

timePrecision     6;

runTimeModifiable true;

// adjustTimeStep  yes;

// maxCo           1;

libs ("libABLkOmegaSST_constBetaStar_clusters_fixNorm_v10.so");
//libs ("libABLkOmegaSST_constBetaStar_multiVariableDomain.so");
